{
  "name": "dsh-answer-me-with-html",
  "version": "0.1.0",
  "description": "Answer me with HTML for DeepSeek Harness: a native tool, DSH-adapted skill, and tool card that render answers as one-page HTML explainers and open them in the Document Preview on Web and Desktop.",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2 <0.3.0-0",
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.2-rc.1": "compatible"
      }
    }
  },
  "files": [
    "lib",
    "skill",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-answer-me-with-html",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "answer-me-with-html",
    "html",
    "explainer"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShanHaiFish/dsh-answer-me-with-html.git"
  },
  "homepage": "https://github.com/ShanHaiFish/dsh-answer-me-with-html#readme",
  "bugs": {
    "url": "https://github.com/ShanHaiFish/dsh-answer-me-with-html/issues"
  },
  "private": true
}
